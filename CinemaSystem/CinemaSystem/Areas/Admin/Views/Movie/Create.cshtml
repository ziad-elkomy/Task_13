@model MovieVM
<form method="post" enctype="multipart/form-data">
	<div class="card mb-3">
		<div class="card-body">
			<div class="row flex-between-center">
				<div class="col-md">
					<h5 class="mb-2 mb-md-0">Add a Movie</h5>
				</div>
				<div class="col-auto">
					<button type="reset" class="btn btn-link text-secondary p-0 me-3 fw-medium" role="button">Discard</button>
					<button type="submit" class="btn btn-primary" role="button">Add Movie </button>
				</div>
			</div>
		</div>
	</div>
	<div class="row g-0">
		<!--////////////////////////////////////////////////////////-->
		<div class="col-lg-8 pe-lg-2">
			<div class="card mb-3">
				<div class="card-header bg-body-tertiary">
					<h6 class="mb-0">Basic information</h6>
				</div>
				<div class="card-body">

					<div class="row gx-2">
						<div class="col-12 mb-3">
							<label class="form-label" for="Name">Movie name:</label>
							<input class="form-control" name="Name" type="text">
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="Price">Movie Price:</label>
							<input class="form-control" name="Price" type="number">
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="Description">Description:</label>
							<textarea class="form-control" name="Description"></textarea>
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="DateTime">Date and Time</label>
							<input type="datetime-local" class="form-control" name="DateTime" />
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="Status">Status: </label>
							<select class="form-select" name="Status">
								<option value="true">Available</option>
								<option value="false">Unavailable</option>
							</select>
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="CategoryId">Category: </label>
							<select class="form-select" name="CategoryId">
								@foreach (var item in Model.Categories)
								{
									<option value="@item.Id">@item.Name</option>
								}
							</select>
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="CinemaId">Cinema: </label>
							<select class="form-select" name="CinemaId">
								@foreach (var item in Model.Cinemas)
								{
									<option value="@item.Id">@item.Name</option>
								}
							</select>
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="MainImageFile">MainImage File:</label>
							<input class="form-control" id="imageInputind" name="MainImageFile" type="file" accept="image/*">
							<div class="image-preview-container" id="previewContainerind"></div>
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="SubImageFiles">SubImage Files:</label>
							<input class="form-control" id="imageInputmulti" name="SubImageFiles" type="file" accept="image/*" multiple>
							<div class="image-preview-container" id="previewContainermulti"></div>
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="MovieActors">Actors:</label>
							<select multiple class="stylish-multi-select" name="MovieActorsIds">
								@foreach (var item in Model.Actors)
								{
									<option value="@item.Id">@item.Name</option>
								}
							</select>
						</div>

					</div>

				</div>
			</div><!--///////////////////////////////////////////////////////////////////////////////-->
		</div>
	</div>
	<div class="card mt-3">
		<div class="card-body">
			<div class="row justify-content-between align-items-center">
				<div class="col-md">
					<h5 class="mb-2 mb-md-0">You're almost done!</h5>
				</div>
				<div class="col-auto">
					<button type="reset" class="btn btn-link text-secondary p-0 me-3 fw-medium" role="button">Discard</button>
					<button type="submit" class="btn btn-primary" role="button">Add Movie</button>
				</div>
			</div>
		</div>
	</div>
</form>

<script>
	const imageInput = document.getElementById('imageInputmulti');
	const previewContainer = document.getElementById('previewContainermulti');

	imageInput.addEventListener('change', function (event) {
		const files = event.target.files;
		previewContainer?.replaceChildren();
		// لو اليوزر اختار صور، بنلف عليهم واحدة بواحدة
		for (let i = 0; i < files.length; i++) {
			const file = files[i];

			// نتأكد إن الملف صورة فعلاً
			if (!file.type.startsWith('image/')) continue;

			const reader = new FileReader();

			reader.onload = function (e) {
				// إنشاء عنصر div لكل صورة
				const card = document.createElement('div');
				card.className = 'image-card';

				// إنشاء عنصر img
				const img = document.createElement('img');
				img.src = e.target.result;

				// تجميع العناصر وإضافتها للصفحة
				card.appendChild(img);
				previewContainer.appendChild(card);
			}

			// قراءة الصورة كـ Data URL
			reader.readAsDataURL(file);
		}
	});
</script>

<script>
	const imageInputind = document.getElementById('imageInputind');
	const imagePreview = document.getElementById('previewContainerind');

	imageInputind.addEventListener('change', function (event) {
		// بنجيب أول ملف اختاره المستخدم
		const file = event.target.files[0];

		if (file) {
			imagePreview.replaceChildren();
			// بنستخدم FileReader عشان نقرأ الملف
			const reader = new FileReader();

			reader.onload = function (e) {
				// إنشاء عنصر div لكل صورة
				const card = document.createElement('div');
				card.className = 'image-card';

				// إنشاء عنصر img
				const img = document.createElement('img');
				img.src = e.target.result;

				// تجميع العناصر وإضافتها للصفحة
				card.appendChild(img);
				imagePreview.appendChild(card);
			}

			// قراءة الملف كـ Data URL
			reader.readAsDataURL(file);
		}
	});
</script>
@using CinemaSystem.Data
@using CinemaSystem.Models
@model Movie
@{
	ApplicationDbContext _context = new ApplicationDbContext();
	var Actors = _context.Actors.ToList();
	var categories = _context.Categories.ToList();
	var cinemas = _context.Cinemas.ToList();
	var movieactors = _context.MovieActors.Where(m => m.MovieId == Model.Id).ToList();
}
<form method="post" enctype="multipart/form-data">
	<div class="card mb-3">
		<div class="card-body">
			<div class="row flex-between-center">
				<div class="col-md">
					<h5 class="mb-2 mb-md-0">Edit a Movie</h5>
				</div>
				<div class="col-auto">
					<button type="reset" class="btn btn-link text-secondary p-0 me-3 fw-medium" role="button">Discard</button>
					<button type="submit" class="btn btn-primary" role="button">Edit Movie </button>
				</div>
			</div>
		</div>
	</div>
	<div class="row g-0">
		<!--////////////////////////////////////////////////////////-->
		<div class="col-lg-8 pe-lg-2">
			<div class="card mb-3">
				<div class="card-header bg-body-tertiary">
					<h6 class="mb-0">Basic information</h6>
				</div>
				<div class="card-body">

					<div class="row gx-2">
						<input type="hidden" name="Id" value="@Model.Id" />
						<div class="col-12 mb-3">
							<label class="form-label" for="Name">Movie name:</label>
							<input class="form-control" name="Name" type="text" value="@Model.Name">
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="Price">Movie Price:</label>
							<input class="form-control" name="Price" type="number" value="@Model.Price">
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="Description">Description:</label>
							<textarea class="form-control" name="Description">@Model.Description</textarea>
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="DateTime">Date and Time</label>
							<input type="datetime-local" class="form-control" name="DateTime" value="@Model.DateTime.ToString("yyyy-MM-ddTHH:mm")" />
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="Status">Status: </label>
							<select class="form-select" name="Status">
								@if (Model.Status)
								{
									<option value="true" selected>Available</option>
									<option value="false">Unavailable</option>
								}
								else
								{
									<option value="true">Available</option>
									<option value="false" selected>Unavailable</option>
								}

							</select>
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="CategoryId">Category: </label>
							<select class="form-select" name="CategoryId">
								@foreach (var item in categories)
								{
									if (item.Id == Model.CategoryId)
									{

										<option value="@item.Id" selected>@item.Name</option>
									}
									else
									{
										<option value="@item.Id">@item.Name</option>
									}
								}
							</select>
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="CinemaId">Cinema: </label>
							<select class="form-select" name="CinemaId">
								@foreach (var item in cinemas)
								{
									if (item.Id == Model.CinemaId)
									{

										<option value="@item.Id" selected>@item.Name</option>
									}
									else
									{
										<option value="@item.Id">@item.Name</option>
									}
								}
							</select>
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="MainImageFile">MainImage File:</label>
							<input class="form-control" name="MainImageFile" type="file" accept="image/*">
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="SubImageFiles">SubImage Files:</label>
							<input class="form-control" name="SubImageFiles" type="file" accept="image/*" multiple>
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="ActorsId">Actors:</label>
							<select multiple class="stylish-multi-select" name="ActorsId">
								@foreach (var item in Actors)
								{
									if (movieactors.Exists(m => m.ActorId == item.Id))
									{
										<option value="@item.Id" selected>@item.Name</option>
									}
									else
									{
										<option value="@item.Id">@item.Name</option>
									}

								}
							</select>
						</div>

					</div>

				</div>
			</div><!--///////////////////////////////////////////////////////////////////////////////-->
		</div>
	</div>
	<div class="card mt-3">
		<div class="card-body">
			<div class="row justify-content-between align-items-center">
				<div class="col-md">
					<h5 class="mb-2 mb-md-0">You're almost done!</h5>
				</div>
				<div class="col-auto">
					<button type="reset" class="btn btn-link text-secondary p-0 me-3 fw-medium" role="button">Discard</button>
					<button type="submit" class="btn btn-primary" role="button">Edit Movie</button>
				</div>
			</div>
		</div>
	</div>
</form>


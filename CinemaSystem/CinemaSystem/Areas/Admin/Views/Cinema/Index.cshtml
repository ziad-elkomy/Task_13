@model IEnumerable<Cinema>
<div class="card">
	<div class="card-body p-0 overflow-hidden">
		<div class="row g-0">
			@foreach (var item in Model)
			{
				<div class="col-12 p-x1">
					<div class="row">
						<div class="col-sm-5 col-md-4">
							<div class="position-relative h-sm-100">
								<img class="img-fluid object-fit-cover w-sm-100 h-sm-100 rounded-1 absolute-sm-centered" src="~/img/Admin/Cinema/@item.Image" alt="">
							</div>
						</div>
						<div class="col-sm-7 col-md-8">
							<div class="row">
								<div class="col-lg-8">
									<h5 class="mt-3 mt-sm-0">@item.Name</h5>
								</div>
								<div class="col-lg-4 d-flex justify-content-between flex-column">
									<div>
										@* <div class="mb-2 mt-3">
										<svg class="svg-inline--fa fa-star fa-w-18 text-warning" aria-hidden="true" focusable="false" data-prefix="fa" data-icon="star" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" data-fa-i2svg=""><path fill="currentColor" d="M259.3 17.8L194 150.2 47.9 171.5c-26.2 3.8-36.7 36.1-17.7 54.6l105.7 103-25 145.5c-4.5 26.3 23.2 46 46.4 33.7L288 439.6l130.7 68.7c23.2 12.2 50.9-7.4 46.4-33.7l-25-145.5 105.7-103c19-18.5 8.5-50.8-17.7-54.6L382 150.2 316.7 17.8c-11.7-23.6-45.6-23.9-57.4 0z"></path></svg><!-- <span class="fa fa-star text-warning"></span> Font Awesome fontawesome.com --><svg class="svg-inline--fa fa-star fa-w-18 text-warning" aria-hidden="true" focusable="false" data-prefix="fa" data-icon="star" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" data-fa-i2svg=""><path fill="currentColor" d="M259.3 17.8L194 150.2 47.9 171.5c-26.2 3.8-36.7 36.1-17.7 54.6l105.7 103-25 145.5c-4.5 26.3 23.2 46 46.4 33.7L288 439.6l130.7 68.7c23.2 12.2 50.9-7.4 46.4-33.7l-25-145.5 105.7-103c19-18.5 8.5-50.8-17.7-54.6L382 150.2 316.7 17.8c-11.7-23.6-45.6-23.9-57.4 0z"></path></svg><!-- <span class="fa fa-star text-warning"></span> Font Awesome fontawesome.com --><svg class="svg-inline--fa fa-star fa-w-18 text-warning" aria-hidden="true" focusable="false" data-prefix="fa" data-icon="star" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" data-fa-i2svg=""><path fill="currentColor" d="M259.3 17.8L194 150.2 47.9 171.5c-26.2 3.8-36.7 36.1-17.7 54.6l105.7 103-25 145.5c-4.5 26.3 23.2 46 46.4 33.7L288 439.6l130.7 68.7c23.2 12.2 50.9-7.4 46.4-33.7l-25-145.5 105.7-103c19-18.5 8.5-50.8-17.7-54.6L382 150.2 316.7 17.8c-11.7-23.6-45.6-23.9-57.4 0z"></path></svg><!-- <span class="fa fa-star text-warning"></span> Font Awesome fontawesome.com --><svg class="svg-inline--fa fa-star fa-w-18 text-warning" aria-hidden="true" focusable="false" data-prefix="fa" data-icon="star" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" data-fa-i2svg=""><path fill="currentColor" d="M259.3 17.8L194 150.2 47.9 171.5c-26.2 3.8-36.7 36.1-17.7 54.6l105.7 103-25 145.5c-4.5 26.3 23.2 46 46.4 33.7L288 439.6l130.7 68.7c23.2 12.2 50.9-7.4 46.4-33.7l-25-145.5 105.7-103c19-18.5 8.5-50.8-17.7-54.6L382 150.2 316.7 17.8c-11.7-23.6-45.6-23.9-57.4 0z"></path></svg><!-- <span class="fa fa-star text-warning"></span> Font Awesome fontawesome.com --><svg class="svg-inline--fa fa-star fa-w-18 text-300" aria-hidden="true" focusable="false" data-prefix="fa" data-icon="star" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" data-fa-i2svg=""><path fill="currentColor" d="M259.3 17.8L194 150.2 47.9 171.5c-26.2 3.8-36.7 36.1-17.7 54.6l105.7 103-25 145.5c-4.5 26.3 23.2 46 46.4 33.7L288 439.6l130.7 68.7c23.2 12.2 50.9-7.4 46.4-33.7l-25-145.5 105.7-103c19-18.5 8.5-50.8-17.7-54.6L382 150.2 316.7 17.8c-11.7-23.6-45.6-23.9-57.4 0z"></path></svg><!-- <span class="fa fa-star text-300"></span> Font Awesome fontawesome.com --><span class="ms-1">(8)</span>
									</div> *@
										<div class="d-none d-lg-block">
											<p class="fs-10 mb-1">
												Status:
												@if (item.Status)
												{
													<strong class="text-success">Available</strong>
												}
												else
												{
													<strong class="text-danger">UnAvailable</strong>
												}
											</p>
										</div>
									</div>
									<div class="mt-2">
										<a class="btn btn-sm btn-warning border-300 d-lg-block me-2 me-lg-0" href="/Admin/Actor/Update/?Id=@item.Id">
											<svg class="svg-inline--fa fa-wrench" aria-hidden="true" focusable="false" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512">
												<path fill="currentColor" d="M507.73 109.1c-2.24-9.03-13.54-12.09-20.12-5.51l-74.36 74.36-67.88-11.31-11.31-67.88 74.36-74.36c6.58-6.58 3.52-17.88-5.51-20.12-66.08-16.44-138.3 4.88-184.28 50.86-53.11 53.11-64.81 131.79-35.15 195.91l-164.5 164.5c-18.75 18.75-18.75 49.14 0 67.88l11.31 11.31c18.75 18.75 49.14 18.75 67.88 0l164.5-164.5c64.12 29.66 142.8 17.96 195.91-35.15 45.98-45.98 67.3-118.2 50.85-184.29z"></path>
											</svg>
											<!-- <span class="far fa-heart"></span> Font Awesome fontawesome.com -->
											<span class="ms-2 d-none d-md-inline-block">Edit</span>
										</a>
										<a class="btn btn-sm btn-danger btn-delete d-lg-block mt-lg-2" href="/Admin/Actor/Delete/?Id=@item.Id">
											<svg class="svg-inline--fa fa-times" aria-hidden="true" focusable="false" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 352 512">
												<path fill="currentColor" d="M242.72 256l100.07-100.07c12.28-12.28 12.28-32.19 0-44.48l-22.24-22.24c-12.28-12.28-32.19-12.28-44.48 0L176 189.28 75.93 89.21c-12.28-12.28-32.19-12.28-44.48 0L9.21 111.45c-12.28 12.28-12.28 32.19 0 44.48L109.28 256 9.21 356.07c-12.28 12.28-12.28 32.19 0 44.48l22.24 22.24c12.28 12.28 32.19 12.28 44.48 0L176 322.72l100.07 100.07c12.28 12.28 32.19 12.28 44.48 0l22.24-22.24c12.28-12.28 12.28-32.19 0-44.48L242.72 256z"></path>
											</svg>
											<!-- <span class="fas fa-cart-plus"> </span> Font Awesome fontawesome.com --><span class="ms-2 d-none d-md-inline-block">Delete</span>
										</a>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			}
		</div>
	</div>
	<div class="card-footer border-top d-flex justify-content-center">
		@if (ViewBag.CurrentPage != 1)
		{
			<a href="/Admin/Cinema/Index/?Page=@(ViewBag.CurrentPage - 1)">
				<button class="btn btn-falcon-default btn-sm me-2" type="button" data-bs-toggle="tooltip" data-bs-placement="top" aria-label="Prev" data-bs-original-title="Prev">
					<svg class="svg-inline--fa fa-chevron-left fa-w-10" aria-hidden="true" focusable="false" data-prefix="fas" data-icon="chevron-left" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512" data-fa-i2svg="">
						<path fill="currentColor" d="M34.52 239.03L228.87 44.69c9.37-9.37 24.57-9.37 33.94 0l22.67 22.67c9.36 9.36 9.37 24.52.04 33.9L131.49 256l154.02 154.75c9.34 9.38 9.32 24.54-.04 33.9l-22.67 22.67c-9.37 9.37-24.57 9.37-33.94 0L34.52 272.97c-9.37-9.37-9.37-24.57 0-33.94z"></path>
					</svg><!-- <span class="fas fa-chevron-left"></span> Font Awesome fontawesome.com -->
				</button>
			</a>
		}
		else
		{
			<button class="btn btn-falcon-default btn-sm me-2" disabled="disabled" type="button" data-bs-toggle="tooltip" data-bs-placement="top" aria-label="Prev" data-bs-original-title="Prev">
				<svg class="svg-inline--fa fa-chevron-left fa-w-10" aria-hidden="true" focusable="false" data-prefix="fas" data-icon="chevron-left" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512" data-fa-i2svg="">
					<path fill="currentColor" d="M34.52 239.03L228.87 44.69c9.37-9.37 24.57-9.37 33.94 0l22.67 22.67c9.36 9.36 9.37 24.52.04 33.9L131.49 256l154.02 154.75c9.34 9.38 9.32 24.54-.04 33.9l-22.67 22.67c-9.37 9.37-24.57 9.37-33.94 0L34.52 272.97c-9.37-9.37-9.37-24.57 0-33.94z"></path>
				</svg><!-- <span class="fas fa-chevron-left"></span> Font Awesome fontawesome.com -->
			</button>
		}

		@for (int i = 1; i <= ViewBag.TotalPages; i++)
		{
			if (i == ViewBag.CurrentPage)
			{
				<a class="btn btn-sm btn-falcon-default text-primary me-2" href="/Admin/Cinema/Index/?Page=@i">@i</a>
			}
			else
			{
				<a class="btn btn-sm btn-falcon-default me-2" href="/Admin/Cinema/Index/?Page=@i">@i</a>
			}
		}
		@if (ViewBag.CurrentPage == ViewBag.TotalPages)
		{
			<button class="btn btn-falcon-default btn-sm" type="button" disabled="disabled" data-bs-toggle="tooltip" data-bs-placement="top" aria-label="Next" data-bs-original-title="Next">
				<svg class="svg-inline--fa fa-chevron-right fa-w-10" aria-hidden="true" focusable="false" data-prefix="fas" data-icon="chevron-right" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512" data-fa-i2svg="">
					<path fill="currentColor" d="M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z"></path>
				</svg><!-- <span class="fas fa-chevron-right"></span> Font Awesome fontawesome.com -->
			</button>
		}
		else
		{
			<a href="/Admin/Cinema/Index/?Page=@(ViewBag.CurrentPage + 1)">
				<button class="btn btn-falcon-default btn-sm me-2" type="button" data-bs-toggle="tooltip" data-bs-placement="top" aria-label="Next" data-bs-original-title="Next">
					<svg class="svg-inline--fa fa-chevron-right fa-w-10" aria-hidden="true" focusable="false" data-prefix="fas" data-icon="chevron-right" role="img" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 320 512" data-fa-i2svg="">
						<path fill="currentColor" d="M285.476 272.971L91.132 467.314c-9.373 9.373-24.569 9.373-33.941 0l-22.667-22.667c-9.357-9.357-9.375-24.522-.04-33.901L188.505 256 34.484 101.255c-9.335-9.379-9.317-24.544.04-33.901l22.667-22.667c9.373-9.373 24.569-9.373 33.941 0L285.475 239.03c9.373 9.372 9.373 24.568.001 33.941z"></path>
					</svg><!-- <span class="fas fa-chevron-right"></span> Font Awesome fontawesome.com -->
				</button>
			</a>
		}

	</div>
</div>

<script>
	document.querySelectorAll('.btn-delete').forEach(button => {
		button.addEventListener('click', function (event) {
			event.preventDefault();
			const deleteurl = this.href;

			Swal.fire({
				title: "Are you sure?",
				text: "You won't be able to revert this!",
				icon: "warning",
				showCancelButton: true,
				confirmButtonColor: "#3085d6",
				cancelButtonColor: "#d33",
				confirmButtonText: "Yes, delete it!"
			}).then((result) => {
				if (result.isConfirmed) {
					window.location.href = deleteurl;
				}
			});
		});
	});
</script>
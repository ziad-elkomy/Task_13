<form method="post" enctype="multipart/form-data">
	<div class="card mb-3">
		<div class="card-body">
			<div class="row flex-between-center">
				<div class="col-md">
					<h5 class="mb-2 mb-md-0">Add a Cinema</h5>
				</div>
				<div class="col-auto">
					<button type="reset" class="btn btn-link text-secondary p-0 me-3 fw-medium" role="button">Discard</button>
					<button type="submit" class="btn btn-primary" role="button">Add Cinema </button>
				</div>
			</div>
		</div>
	</div>
	<div class="row g-0">
		<!--////////////////////////////////////////////////////////-->
		<div class="col-lg-8 pe-lg-2">
			<div class="card mb-3">
				<div class="card-header bg-body-tertiary">
					<h6 class="mb-0">Basic information</h6>
				</div>
				<div class="card-body">

					<div class="row gx-2">
						<div class="col-12 mb-3">
							<label class="form-label" for="Name">Cinema name:</label>
							<input class="form-control" name="Name" type="text">
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="Description">Description:</label>
							<textarea class="form-control" name="Description"></textarea>
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="Status">Status: </label>
							<select class="form-select" name="Status">
								<option value="true">Available</option>
								<option value="false">Unavailable</option>
							</select>
						</div>
						<div class="col-12 mb-3">
							<label class="form-label" for="ImageFile">ImageFile:</label>
							<input class="form-control" name="ImageFile" type="file" accept="image/*">
						</div>
					</div>

				</div>
			</div><!--///////////////////////////////////////////////////////////////////////////////-->
		</div>
	</div>
	<div class="card mt-3">
		<div class="card-body">
			<div class="row justify-content-between align-items-center">
				<div class="col-md">
					<h5 class="mb-2 mb-md-0">You're almost done!</h5>
				</div>
				<div class="col-auto">
					<button type="reset" class="btn btn-link text-secondary p-0 me-3 fw-medium" role="button">Discard</button>
					<button type="submit" class="btn btn-primary" role="button">Add Cinema</button>
				</div>
			</div>
		</div>
	</div>
</form>